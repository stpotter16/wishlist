# Change these names and update them
export WISHLIST_DB_PATH="${HOME}/data/wishlist"
export WISHLIST_SESSION_ENV_KEY="Output of make secrets/hmac"

# Cloudflare's test keys, which always pass. Production uses the real widget's
# keys from the Cloudflare dashboard.
export WISHLIST_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
export WISHLIST_TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Absolute URL the app is served from, used for links in emails. Production
# uses the custom domain, such as https://wishlist.example.org, not fly.dev.
export WISHLIST_BASE_URL="http://localhost:8080"

# Resend sends givers their private links. Locally, a dummy key works: sends
# fail and get logged, and claims still go through.
export WISHLIST_RESEND_API_KEY="Resend API key"
# Must be on a domain verified in Resend, or Resend rejects the send. The
# mailbox doesn't need to exist, so noreply@ works.
export WISHLIST_EMAIL_FROM="Wishlist <noreply@example.org>"
# Where givers' replies go. Any address the organizers read, on any domain;
# Resend doesn't verify it.
export WISHLIST_EMAIL_REPLY_TO="organizers@example.org"
